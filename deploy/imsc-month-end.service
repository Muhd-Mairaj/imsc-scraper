[Unit]
Description=Send the IMSC month-end engagement report
After=network-online.target docker.service imsc-stack.service
Wants=network-online.target imsc-stack.service
# Bound restart attempts so a persistent fault cannot spin indefinitely.
# StartLimit* live in [Unit]; systemd ignores them in [Service].
StartLimitBurst=3
StartLimitIntervalSec=6h

[Service]
Type=oneshot
TimeoutStartSec=15min
# Install with `deploy/install.sh`, which rewrites this to the checkout it runs
# from and `ExecStart` to the docker binary on the host.
WorkingDirectory=/path/to/imsc-scraper
EnvironmentFile=-/etc/imsc-month-end.env
ExecStartPre=-/usr/bin/docker rm -f imsc-month-end
ExecStart=/usr/bin/docker compose --profile tools run --rm --name imsc-month-end imsc-report month-end
ExecStop=-/usr/bin/docker rm -f imsc-month-end
TimeoutStopSec=60
Restart=on-failure
RestartSec=10min
