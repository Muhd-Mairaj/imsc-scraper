[Unit]
Description=Start the IMSC WAHA GOWS stack
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/path/to/imsc-scraper
TimeoutStartSec=15min
ExecStart=/usr/bin/docker compose up -d --wait waha imsc-ingest
ExecStop=/usr/bin/docker compose stop waha imsc-ingest

[Install]
WantedBy=multi-user.target
