[Unit]
Description=Send the IMSC weekly engagement report
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mairaj/Documents/imsc-scraper
ExecStart=/usr/bin/docker compose run --rm imsc weekly
Restart=on-failure
RestartSec=30min
StartLimitBurst=3
StartLimitIntervalSec=6h
