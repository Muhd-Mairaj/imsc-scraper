# WAHA requires this key in the X-Api-Key header on every API call.
WAHA_API_KEY=replace-with-a-long-random-string

# Dashboard and Swagger logins. Set these explicitly; if they are missing,
# WAHA generates and prints new credentials on every container start.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-string
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-long-random-string

# Match the owner of ./data on the host so state and SQLite remain writable.
IMSC_UID=1000
IMSC_GID=1000
